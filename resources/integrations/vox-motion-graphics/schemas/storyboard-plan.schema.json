{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vox-motion-graphics.local/schemas/storyboard-plan.schema.json",
  "title": "v0.10 HTML Storyboard Plan",
  "type": "object",
  "required": ["projectId", "preview", "status", "scenes"],
  "properties": {
    "projectId": {"type": "string", "minLength": 1},
    "preview": {"type": "object", "required": ["path", "mode"], "properties": {"path": {"type": "string", "minLength": 1}, "mode": {"enum": ["lightweight", "playable"]}}, "additionalProperties": false},
    "status": {"enum": ["draft", "in_review", "ready_for_approval", "frozen"]},
    "direction": {"$ref": "direction-plan.schema.json"},
    "freezeEvidence": {"type": "object", "required": ["reviewer", "reviewRef", "independent"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "reviewRef": {"type": "string", "minLength": 1}, "independent": {"const": true}, "frozenAt": {"type": "string"}}, "additionalProperties": false},
    "reviewEvidence": {"type": "object", "required": ["reviewer", "reviewRef", "independent"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "reviewRef": {"type": "string", "minLength": 1}, "independent": {"const": true}}, "additionalProperties": false},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "beatIds", "visualThesis", "focalPoint", "dominantRelationship", "constructionFamily", "assetIds", "states", "transitionIntent"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "beatIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "visualThesis": {"type": "string", "minLength": 1},
          "focalPoint": {"type": "string", "minLength": 1},
          "dominantRelationship": {"type": "string", "minLength": 1},
          "constructionFamily": {"type": "string", "minLength": 1},
          "assetIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "states": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["id", "purpose", "focalElement"],
              "properties": {
                "id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "focalElement": {"type": "string", "minLength": 1},
                "meaningfulChange": {"type": "string", "minLength": 1}, "intentionalHoldReason": {"type": "string", "minLength": 1},
                "narrationAnchor": {"type": "string"}, "assetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              },
              "additionalProperties": false,
              "oneOf": [{"required": ["meaningfulChange"]}, {"required": ["intentionalHoldReason"]}]
            }
          },
          "relationshipInvariants": {"type": "array", "items": {"type": "object", "required": ["id", "observable", "proofRef"], "properties": {"id": {"type": "string", "minLength": 1}, "observable": {"type": "string", "minLength": 1}, "proofRef": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
          "shotScore": {"type": "object", "required": ["composition", "objectAction", "camera", "attention", "rhythm", "sound", "exit"], "properties": {"composition": {"type": "string", "minLength": 1}, "objectAction": {"type": "string", "minLength": 1}, "camera": {"type": "string", "minLength": 1}, "attention": {"type": "string", "minLength": 1}, "rhythm": {"type": "string", "minLength": 1}, "sound": {"type": "string", "minLength": 1}, "exit": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "motionIntent": {"type": "string"}, "transitionIntent": {"type": "string", "minLength": 1}, "representationRisk": {"type": "string"}, "notes": {"type": "array", "items": {"type": "string"}},
          "vocabularyIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "visualJob": {"enum": ["explanation", "identification", "evidence", "chronology", "atmosphere", "emotion", "payoff"]},
          "stateDelta": {"type": "object", "required": ["before", "operation", "after", "viewerInference"], "properties": {"before": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1}, "after": {"type": "string", "minLength": 1}, "viewerInference": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "rhythmProfile": {"$ref": "direction-plan.schema.json#/$defs/rhythmProfile"},
          "conceptSearch": {"type": "object", "required": ["candidates", "selectedId", "selectionReason"], "properties": {"candidates": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "object", "required": ["id", "family", "inference", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "family": {"type": "string", "minLength": 1}, "inference": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "selectedId": {"type": "string", "minLength": 1}, "selectionReason": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "attentionHandoff": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["continuity", "contrast", "reset", "hold", "archival_cut", "sound_led", "end"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "payoffConstruction": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false,
        "allOf": [
          {"if": {"properties": {"visualJob": {"const": "explanation"}}, "required": ["visualJob"]}, "then": {"required": ["stateDelta"]}},
          {"if": {"properties": {"visualJob": {"const": "payoff"}}, "required": ["visualJob"]}, "then": {"required": ["payoffConstruction"]}}
        ]
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"status": {"const": "frozen"}}, "required": ["status"]}, "then": {"required": ["freezeEvidence"]}},
    {"if": {"properties": {"status": {"const": "ready_for_approval"}}, "required": ["status"]}, "then": {"required": ["reviewEvidence"]}}
  ]
}