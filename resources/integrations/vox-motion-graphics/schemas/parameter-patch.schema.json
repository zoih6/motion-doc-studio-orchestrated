{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critic Parameter Patch",
  "type": "object",
  "required": [
    "critic",
    "renderId",
    "changes"
  ],
  "properties": {
    "critic": {
      "type": "string",
      "minLength": 1
    },
    "renderId": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sceneId",
          "parameter",
          "newValue",
          "reason",
          "expectedEffect",
          "confidence"
        ],
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "parameter": {
            "type": "string"
          },
          "oldValue": {},
          "newValue": {},
          "reason": {
            "type": "string"
          },
          "expectedEffect": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "requiresRedesign": {
      "type": "boolean"
    },
    "redesignReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
