{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Motion Graphics Claim Set",
  "type": "object",
  "required": ["topic", "sources", "claims"],
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string"},
          "publisher": {"type": "string"},
          "publishedAt": {"type": "string"},
          "accessedAt": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "status", "risk", "sourceRefs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "unverified", "disputed", "inference"]},
          "risk": {"enum": ["low", "medium", "high"]},
          "sourceRefs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
            "then": {"properties": {"sourceRefs": {"minItems": 1}}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
