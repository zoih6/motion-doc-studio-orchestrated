{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.9.0 Narration and Frame Timing Specification",
  "type": "object",
  "required": ["fps", "alignmentSource", "compositionDurationSec", "scenes"],
  "properties": {
    "fps": {"type": "number", "minimum": 1},
    "alignmentSource": {"type": "string", "minLength": 1},
    "compositionDurationSec": {"type": "number", "exclusiveMinimum": 0},
    "voiceoverEndSec": {"type": ["number", "null"], "minimum": 0},
    "captionEndSec": {"type": ["number", "null"], "minimum": 0},
    "finalHold": {
      "type": ["object", "null"],
      "properties": {
        "startSec": {"type": "number", "minimum": 0},
        "endSec": {"type": "number", "minimum": 0},
        "intentional": {"const": true},
        "reviewed": {"const": true},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["startSec", "endSec", "intentional", "reviewed", "reason"],
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sceneId", "sceneStartSec", "sceneDurationSec", "microbeats"],
        "properties": {
          "sceneId": {"type": "string", "minLength": 1},
          "sceneStartSec": {"type": "number", "minimum": 0},
          "sceneDurationSec": {"type": "number", "exclusiveMinimum": 0},
          "captionEndSec": {"type": ["number", "null"], "minimum": 0},
          "microbeats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["offsetSec", "event", "motionRole"],
              "properties": {
                "offsetSec": {"type": "number", "minimum": 0},
                "event": {"type": "string", "minLength": 1},
                "narrationAnchor": {"type": "string"},
                "semanticTiming": {
                  "type": "object",
                  "description": "Scene-local windows; validator checks ordering, independent review checks meaning and readability.",
                  "required": ["phrase", "orientationStartSec", "triggerSec", "actionCompleteSec", "readableStartSec", "readableEndSec", "transitionStartSec", "transitionEndSec"],
                  "properties": {
                    "phrase": {"type": "string", "minLength": 1},
                    "orientationStartSec": {"type": "number", "minimum": 0},
                    "triggerSec": {"type": "number", "minimum": 0},
                    "actionCompleteSec": {"type": "number", "minimum": 0},
                    "readableStartSec": {"type": "number", "minimum": 0},
                    "readableEndSec": {"type": "number", "minimum": 0},
                    "transitionStartSec": {"type": "number", "minimum": 0},
                    "transitionEndSec": {"type": "number", "minimum": 0}
                  },
                  "additionalProperties": false
                },
                "motionRole": {"enum": ["primary", "support", "camera", "hold", "transition", "audio"]},
                "focalTarget": {"type": "string"},
                "storyboardStateId": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "sfxEvents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["offsetSec", "visualEvent", "sfx"],
              "properties": {
                "offsetSec": {"type": "number", "minimum": 0},
                "visualEvent": {"type": "string", "minLength": 1},
                "sfx": {"type": "string", "minLength": 1},
                "disposition": {"enum": ["implemented", "replaced", "omitted"]},
                "decisionReason": {"type": "string", "minLength": 1},
                "syncPoint": {"enum": ["attack", "movement", "settle", "release", "transition"]}
              },
              "additionalProperties": false,
              "allOf": [{
                "if": {"properties": {"disposition": {"enum": ["replaced", "omitted"]}}, "required": ["disposition"]},
                "then": {"required": ["decisionReason"]}
              }]
            }
          },
          "implementationNotes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
